{
  "name": "loopback",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --test src/*.test.ts",
    "dev": "vite",
    "build": "vite build",
    "vendor": "bash scripts/vendor.sh",
    "predev": "npm run vendor",
    "prebuild": "npm run vendor",
    "build:java": "rm -rf build/java && javac --release 8 -Xlint:-options -nowarn -cp public/vendor/java/tools.jar -d build/java java/loopback/*.java && jar --create --file public/java-harness.jar -C build/java . && rm -rf build",
    "build:go": "cd go && GOOS=wasip1 GOARCH=wasm go build -ldflags=\"-s -w\" -o ../public/vendor/go/yaegi.wasm . && gzip -9f ../public/vendor/go/yaegi.wasm"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@runno/wasi": "^0.10.0",
    "@yowasp/clang": "^22.0.0-git20542-10",
    "codemirror": "^6.0.2",
    "pyodide": "^314.0.6",
    "sucrase": "^3.35.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
